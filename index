<script>
// ==================================
// PERSONALIZAÇÃO
// ==================================

// Altere para a senha que você quiser.
// O Mozi precisará digitar exatamente essa senha.
const senhaSecreta = "mozi2025";

// Data de início do namoro: 13/04/2025
const inicioNamoro = new Date(2025, 3, 13);

// ==================================
// CÉU ESTRELADO
// ==================================

const ceu = document.getElementById("ceu");

for (let i = 0; i < 100; i++) {
  const estrela = document.createElement("span");
  estrela.className = "estrela";

  estrela.style.left = Math.random() * 100 + "%";
  estrela.style.top = Math.random() * 100 + "%";

